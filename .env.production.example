# ════════════════════════════════════════════════════════════
# FRONTEND — Variables Netlify (Site settings → Environment variables)
# ════════════════════════════════════════════════════════════
# ⚠️ IMPORTANT : l'URL doit inclure /api à la fin
VITE_API_URL=https://na2quiztraining-backend.onrender.com/api

# Widget Campay (clé publique — sans danger côté client)
VITE_CAMPAY_APP_ID=votre_app_id_campay
VITE_CAMPAY_ENV=demo

# Cloudinary (nom du cloud seulement — public)
VITE_CLOUDINARY_CLOUD_NAME=votre_cloud_name

VITE_APP_NAME=NA2 Quiz Training
