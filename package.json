{
  "name": "na2-quiz-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "import-questions": "node scripts/importQuestions.js",
    "generate-icons": "node scripts/generate-pwa-icons.js",
