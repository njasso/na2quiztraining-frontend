# frontend/.env.example
# ⚠️  COPIER en .env.local — ne JAMAIS commiter le .env réel
# ⚠️  Seules les variables VITE_ sont exposées au navigateur

# URL du backend
VITE_API_URL=http://localhost:5000

# Infos app
VITE_APP_NAME=NA2 Quiz
VITE_DEV_MODE=true

# IA (si appels depuis le frontend — ATTENTION : clé visible dans le bundle)
# Préférer passer les appels IA côté backend uniquement
# VITE_APP_DEEPSEEK_API_KEY=JAMAIS_METTRE_ICI_EN_PRODUCTION

# Firebase (si utilisé)
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=...
# VITE_FIREBASE_PROJECT_ID=...
# VITE_FIREBASE_STORAGE_BUCKET=...
# VITE_FIREBASE_MESSAGING_SENDER_ID=...
# VITE_FIREBASE_APP_ID=...
